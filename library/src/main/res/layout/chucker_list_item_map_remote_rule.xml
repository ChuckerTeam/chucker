<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/chucker_doub_grid">

    <TextView
        android:id="@+id/requestUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Chucker.TextAppearance.ListItem"
        tools:text="POST https://example.com/path" />

    <TextView
        android:id="@+id/targetUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/chucker_half_grid"
        android:textColor="@color/chucker_status_300"
        tools:text="→ https://mock.example.com/path" />

</LinearLayout>
