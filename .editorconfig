[*]
charset = utf-8
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.yml]
indent_size = 2

[**/test/**.kt]
ktlint_ignore_back_ticked_identifier = true

# Added to support compose function naming convection for sample Compose screens:
[*.{kt,kts}]
ktlint_function_naming_ignore_when_annotated_with = Composable

# for library theme:
[library/src/main/kotlin/com/chuckerteam/chucker/internal/ui/theme/**/*.kt]
ktlint_standard_function-naming = disabled